rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth.uid == request.resource.data.owner;
      allow update, delete: if request.auth.uid == resource.data.owner;

      match /htmlChunks/{chunkId} {
        allow read, write: if request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.owner;
      }
    }
  }
}
