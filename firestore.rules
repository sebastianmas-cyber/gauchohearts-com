rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      // 1. Allow public read access
      allow read: if true;

      // 2. Allow creation if the user is the owner
      allow create: if request.auth.uid == request.resource.data.owner;

      // 3. Allow updates and deletes if the user is the owner
      allow update, delete: if request.auth.uid == resource.data.owner;
    }
  }
}
