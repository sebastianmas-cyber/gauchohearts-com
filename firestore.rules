rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // General access rules for all documents
    match /{document=**} {
      // Allow anyone to read any document
      allow read: if true;

      // Allow any authenticated user to write to any document
      allow write: if request.auth != null;
    }

    // Override: Specific rule for the public project storage
    match /projects/{projectId}/storage/{storageId} {
      // Allow ANYONE (authenticated or not) to write here.
      // This rule is additive. It grants public write access to this
      // specific subcollection, while the rule above grants authenticated
      // write access everywhere else.
      allow write: if true;
    }
  }
}
